+fn normalize_ipv4_source(packet: &mut [u8]) {
+    const GUEST_IP: [u8; 4] = [10, 0, 0, 2];
+    if packet.len() < 20 || packet[0] >> 4 != 4 || packet[12..16] != [0, 0, 0, 0] {
+        return;
+    }
+    let header_len = usize::from(packet[0] & 0x0f) * 4;
+    if header_len < 20 || packet.len() < header_len {
+        return;
+    }
