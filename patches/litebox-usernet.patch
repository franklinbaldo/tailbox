+        GUEST_IP[1],
+        GUEST_IP[2],
+        GUEST_IP[3],
+        destination[0],
+        destination[1],
+        destination[2],
+        destination[3],
+        0,
+        protocol,
+        (transport_len >> 8) as u8,
+        transport_len as u8,
+    ];
+    let mut checksum = internet_checksum(&[&pseudo_header, transport]);
+    if protocol == 17 && checksum == 0 {
+        checksum = u16::MAX;
+    }
+    transport[checksum_offset..checksum_offset + 2].copy_from_slice(&checksum.to_be_bytes());
