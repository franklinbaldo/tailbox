+    packet[12..16].copy_from_slice(&GUEST_IP);
+    packet[10..12].fill(0);
+    let header_checksum = internet_checksum(&[&packet[..header_len]]);
+    packet[10..12].copy_from_slice(&header_checksum.to_be_bytes());
+
+    let protocol = packet[9];
+    let destination = [packet[16], packet[17], packet[18], packet[19]];
+    let transport = &mut packet[header_len..];
+    let checksum_offset = match protocol {
+        6 if transport.len() >= 18 => 16,
+        17 if transport.len() >= 8 => 6,
+        _ => return,
+    };
+    transport[checksum_offset..checksum_offset + 2].fill(0);
+    let transport_len = u16::try_from(transport.len()).expect("transport packet too large");
+    let pseudo_header = [
