diff --git a/litebox_packager/examples/replace_tar_entry.rs b/litebox_packager/examples/replace_tar_entry.rs
new file mode 100644
--- /dev/null
+++ b/litebox_packager/examples/replace_tar_entry.rs
@@ -0,0 +1,54 @@
+use std::{env, fs, io::BufReader, process};
+
+fn main() {
+    let mut args = env::args_os().skip(1);
+    let (Some(input_tar), Some(output_tar), Some(entry_path), Some(replacement)) =
+        (args.next(), args.next(), args.next(), args.next())
+    else {
+        eprintln!("usage: replace_tar_entry INPUT_TAR OUTPUT_TAR ENTRY_PATH REPLACEMENT");
+        process::exit(2);
+    };
+    if args.next().is_some() {
+        eprintln!("usage: replace_tar_entry INPUT_TAR OUTPUT_TAR ENTRY_PATH REPLACEMENT");
+        process::exit(2);
+    }
+
+    let replacement_data = fs::read(replacement).expect("failed to read replacement");
+    let input = fs::File::open(input_tar).expect("failed to open input tar");
+    let output = fs::File::create(output_tar).expect("failed to create output tar");
+    let mut archive = tar::Archive::new(BufReader::new(input));
+    let mut builder = tar::Builder::new(output);
+    let wanted = entry_path.to_string_lossy();
+    let mut replaced = false;
+
+    for entry in archive.entries().expect("failed to read tar entries") {
+        let mut entry = entry.expect("failed to read tar entry");
+        let path = entry.path().expect("invalid tar entry path");
+        let mut header = entry.header().clone();
+        if path.to_string_lossy().replace('\\', "/") == wanted {
+            header.set_size(replacement_data.len() as u64);
+            header.set_cksum();
+            builder
+                .append(&header, replacement_data.as_slice())
+                .expect("failed to append replacement");
+            replaced = true;
+        } else {
+            builder
+                .append(&header, &mut entry)
+                .expect("failed to copy tar entry");
+        }
+    }
+    if !replaced {
+        let mut header = tar::Header::new_gnu();
+        header.set_mode(0o644);
+        header.set_uid(0);
+        header.set_gid(0);
+        header.set_mtime(0);
+        header.set_size(replacement_data.len() as u64);
+        header.set_cksum();
+        builder
+            .append_data(&mut header, wanted.as_ref(), replacement_data.as_slice())
+            .expect("failed to append new entry");
+    }
+    builder.finish().expect("failed to finish output tar");
+}
diff --git a/litebox_syscall_rewriter/examples/rewrite_elf.rs b/litebox_syscall_rewriter/examples/rewrite_elf.rs
new file mode 100644
--- /dev/null
+++ b/litebox_syscall_rewriter/examples/rewrite_elf.rs
@@ -0,0 +1,22 @@
+use std::{env, fs, process};
+
+fn main() {
+    let mut args = env::args_os().skip(1);
+    let Some(input) = args.next() else {
+        eprintln!("usage: rewrite_elf INPUT OUTPUT");
+        process::exit(2);
+    };
+    let Some(output) = args.next() else {
+        eprintln!("usage: rewrite_elf INPUT OUTPUT");
+        process::exit(2);
+    };
+    if args.next().is_some() {
+        eprintln!("usage: rewrite_elf INPUT OUTPUT");
+        process::exit(2);
+    }
+
+    let input_data = fs::read(&input).expect("failed to read input ELF");
+    let rewritten = litebox_syscall_rewriter::hook_syscalls_in_elf(&input_data, None)
+        .expect("failed to rewrite ELF");
+    fs::write(output, rewritten).expect("failed to write rewritten ELF");
+}
